datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  
  // Custom VTU fields
  phone         String?         @unique
  password      String?         // Optional because of OAuth
  walletBalance Float           @default(0.0)
  role          Role            @default(USER)
  isSuspended   Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  transactions  WalletTransaction[]
  airtime       AirtimePurchase[]
  data          DataPurchase[]
  trackers      VehicleTracker[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  ADMIN
}

model WalletTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  type      TxType
  reference String   @unique
  status    TxStatus
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

enum TxType {
  CREDIT
  DEBIT
}

enum TxStatus {
  PENDING
  SUCCESS
  FAILED
}

model AirtimePurchase {
  id                String          @id @default(cuid())
  userId            String
  network           String
  phone             String
  amount            Float
  reference         String          @unique
  status            TxStatus
  providerReference String?
  serverId          String?
  serverName        String?
  provider          String?
  trackerId         String?
  createdAt         DateTime        @default(now())

  user              User            @relation(fields: [userId], references: [id])
  tracker           VehicleTracker? @relation(fields: [trackerId], references: [id], onDelete: SetNull)
}

model DataPurchase {
  id                String          @id @default(cuid())
  userId            String
  network           String
  plan              String
  phone             String
  amount            Float
  reference         String          @unique
  status            TxStatus
  providerReference String?
  serverId          String?
  serverName        String?
  provider          String?
  trackerId         String?
  createdAt         DateTime        @default(now())

  user              User            @relation(fields: [userId], references: [id])
  tracker           VehicleTracker? @relation(fields: [trackerId], references: [id], onDelete: SetNull)
}

model VehicleTracker {
  id                 String           @id @default(cuid())
  userId             String
  vehicleName        String           // e.g. "Toyota Hilux (Fleet #12)"
  plateNumber        String           // e.g. "ABJ-842-LK"
  simNumber          String           // Phone number of tracker SIM (e.g. "08031234567")
  network            String           // "01" (MTN), "02" (GLO), "03" (9mobile), "04" (AIRTEL)
  deviceModel        String?          // e.g. "Concox GT06N", "Coban TK103", "Teltonika FMB920"
  imei               String?          // e.g. "864210048123456"
  clientName         String?          // Fleet owner / Client name
  clientPhone        String?          // Client phone contact
  notes              String?          // Installation notes / vehicle info
  status             TrackerStatus    @default(ACTIVE)

  // Last Airtime Details (Instant troubleshooting info)
  lastAirtimeDate    DateTime?
  lastAirtimeAmount  Float?
  lastAirtimeRef     String?

  // Last Data Details (Instant troubleshooting info)
  lastDataDate       DateTime?
  lastDataPlan       String?          // e.g. "500MB SME (30 Days)"
  lastDataAmount     Float?
  lastDataRef        String?
  dataValidityDays   Int?             @default(30)
  dataExpiryDate     DateTime?        // Calculated timestamp when data is expected to run out

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  airtimePurchases   AirtimePurchase[]
  dataPurchases      DataPurchase[]

  @@index([userId])
  @@index([simNumber])
  @@index([plateNumber])
  @@index([dataExpiryDate])
}

enum TrackerStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  INACTIVE
}

model Provider {
  id               String   @id @default(cuid())
  serverName       String   @default("Server 1") // e.g. "Server 1 (Fast Airtime/Data)"
  serverCode       String?  @unique              // e.g. "server-1", "server-2"
  providerName     String                        // e.g. "ClubKonnect", "VTPass", "Husmodata"
  identifier       String                        // e.g. "CLUBKONNECT", "VTPASS", "HUSMODATA", "MOCK"
  apiKey           String
  secretKey        String?
  userId           String?
  publicKey        String?
  baseUrl          String
  lastKnownBalance Float?   @default(0)          // Tracks previous provider balance for delta deposit detection
  status           Boolean  @default(true)       // true means enabled for user selection
  isDefault        Boolean  @default(false)      // default selected server
  sortOrder        Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
}

